        <div style={S.body}>
          {page==="dashboard"&&<DashboardPage doctors={doctors} shifts={shifts} coverages={coverages} absences={absences} leaves={leaves} today={today}/>}
          {page==="doctors"&&!selDoc&&<DoctorsPage doctors={doctors} leaves={leaves} today={today} onEdit={d=>{setSelDoc(d);setPage("schedule");}} onDelete={id=>{setDoctors(p=>p.filter(d=>d.id!==id));showToast("تم الحذف","warn");}} onAdd={()=>{const name=prompt("اسم الطبيب:");if(!name)return;const doc={id:Date.now(),name,color:["#6366f1","#0ea5e9","#10b981","#f59e0b","#ec4899"][Math.floor(Math.random()*5)],sched:Object.fromEntries([0,1,2,3,4].map(d=>[d,{am:"",pm:""}]))};setDoctors(p=>[...p,doc]);setSelDoc(doc);setPage("schedule");}}/>}
          {page==="schedule"&&selDoc&&<SchedulePage doctor={selDoc} onChange={(di,p,v)=>{updateSched(selDoc.id,di,p,v);setSelDoc(prev=>({...prev,sched:{...prev.sched,[di]:{...prev.sched[di],[p]:v}}}));}} onSave={()=>showToast("✅ تم حفظ الجدول")}/>}
          {page==="shifts"&&<ShiftsPage doctors={doctors} shifts={shifts} leaves={leaves} coverages={coverages} onAdd={s=>{setShifts(p=>[...p,{id:Date.now(),...s,coverAm:null,coverPm:null}]);showToast("تم تسجيل المناوبة");}} onAssign={addShiftCov} onDelete={id=>{setShifts(p=>p.filter(s=>s.id!==id));showToast("تم الحذف","warn");}}/>}
          {page==="coverage"&&<CoveragePage doctors={doctors} coverages={coverages} absences={absences} leaves={leaves} shifts={shifts} onAddAbsence={a=>{setAbsences(p=>[...p,{id:Date.now(),...a}]);showToast("تم تسجيل الغياب");}} onAssign={addAbsCov} onDeleteAbsence={id=>{setAbsences(p=>p.filter(a=>a.id!==id));setCoverages(p=>p.filter(c=>c.refId!==id));showToast("تم الحذف","warn");}}/>}
          {page==="leaves"&&<LeavesPage doctors={doctors} leaves={leaves} onAdd={l=>{setLeaves(p=>[...p,{id:Date.now(),...l}]);showToast("تم تسجيل الإجازة");}} onDelete={id=>{setLeaves(p=>p.filter(l=>l.id!==id));showToast("تم الحذف","warn");}}/>}
          {page==="stats"&&<StatsPage doctors={doctors} shifts={shifts} coverages={coverages} absences={absences} leaves={leaves}/>}
        </div>
      </main>
      {toast&&<div style={{...S.toast,background:toast.type==="warn"?"#d97706":"#15803d"}}>{toast.msg}</div>}
    </div>
  );
}

