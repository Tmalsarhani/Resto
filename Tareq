// LEAVES PAGE
// ══════════════════════════════════════
function LeavesPage({doctors,leaves,onAdd,onDelete}){
  const [form,setForm]=useState({doctorId:"",start:"",end:"",type:"annual"});
  const [showForm,setShowForm]=useState(false);
  const types={annual:"سنوية",sick:"مرضية",emergency:"طارئة",other:"أخرى"};
  const doc=(id)=>doctors.find(d=>d.id===id);
  return(
    <div>
      <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:14}}>
        <div style={{fontWeight:700}}>الإجازات ({leaves.length})</div>
        <button style={S.btnP} onClick={()=>setShowForm(true)}>+ إجازة جديدة</button>
      </div>
      {showForm&&(
        <div style={S.formCard}>
          <div style={{fontWeight:800,fontSize:14,marginBottom:10}}>🏖 إجازة جديدة</div>
          <label style={S.lbl}>الطبيب</label>
          <select style={S.sel} value={form.doctorId} onChange={e=>setForm(p=>({...p,doctorId:e.target.value}))}>
            <option value="">اختر...</option>{doctors.map(d=><option key={d.id} value={d.id}>{d.name}</option>)}
          </select>
          <label style={S.lbl}>النوع</label>
          <select style={S.sel} value={form.type} onChange={e=>setForm(p=>({...p,type:e.target.value}))}>
            {Object.entries(types).map(([k,v])=><option key={k} value={k}>{v}</option>)}
          </select>
          <div style={{display:"flex",gap:8}}>
            <div style={{flex:1}}><label style={S.lbl}>من</label><input type="date" style={S.sel} value={form.start} onChange={e=>setForm(p=>({...p,start:e.target.value}))}/></div>
            <div style={{flex:1}}><label style={S.lbl}>إلى</label><input type="date" style={S.sel} value={form.end} onChange={e=>setForm(p=>({...p,end:e.target.value}))}/></div>
          </div>
          <div style={{display:"flex",gap:8,marginTop:10}}>
            <button style={S.btnP} onClick={()=>{if(!form.doctorId||!form.start||!form.end)return;onAdd({doctorId:+form.doctorId,start:form.start,end:form.end,type:form.type});setForm({doctorId:"",start:"",end:"",type:"annual"});setShowForm(false);}}>حفظ</button>
            <button style={S.btnS} onClick={()=>setShowForm(false)}>إلغاء</button>
          </div>
        </div>
      )}
      {leaves.length===0&&<div style={S.empty}>لا توجد إجازات</div>}
      {leaves.map(l=>{const d=doc(l.doctorId);if(!d)return null;const days=Math.round((new Date(l.end)-new Date(l.start))/86400000)+1;return(
        <div key={l.id} style={{background:"#fff",border:"1px solid #e2e8f0",borderRadius:10,padding:"10px 14px",marginBottom:8,display:"flex",alignItems:"center",gap:10}}>
          <div style={{...S.av,background:d.color,width:30,height:30,fontSize:11}}>{shortName(d.name)}</div>
          <div style={{flex:1}}><div style={{fontWeight:700,fontSize:13}}>{d.name}</div><div style={{fontSize:11,color:"#64748b"}}>{l.start} → {l.end} ({days} أيام) — {types[l.type]}</div></div>
          <button style={S.btnDel} onClick={()=>onDelete(l.id)}>🗑</button>
        </div>
      );})}
    </div>
  );
}

