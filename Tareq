                      {dayShifts.map(s=>{const d=doctors.find(x=>x.id===s.coverPm);return d&&<DocChip key={s.id} doc={d} warn={s.warnPm}/>;})}{dayCovs.filter(c=>c.period==="pm").map(c=>{const d=doctors.find(x=>x.id===c.coverDoctorId);return d&&<DocChip key={c.id} doc={d} warn={c.hadConflict}/>;})}{!dayShifts.some(s=>s.coverPm)&&!dayCovs.some(c=>c.period==="pm")&&<span style={{color:"#e2e8f0",fontSize:11}}>—</span>}
                    </td>
                    <td style={{padding:"6px 8px",verticalAlign:"top"}}>
                      {dayAbsences.map(a=>{const d=doctors.find(x=>x.id===a.doctorId);return d&&<DocChip key={a.id} doc={d}/>;})}{!dayAbsences.length&&<span style={{color:"#e2e8f0",fontSize:11}}>—</span>}
                    </td>
                    <td style={{padding:"6px 8px",verticalAlign:"top"}}>
                      {dayLeaves.map(l=>{const d=doctors.find(x=>x.id===l.doctorId);return d&&<DocChip key={l.id} doc={d}/>;})}{!dayLeaves.length&&<span style={{color:"#e2e8f0",fontSize:11}}>—</span>}
                    </td>
                  </tr>
                );
              })}
              {eventsByDate.every(e=>!e.dayShifts?.length&&!e.dayAbsences?.length&&!e.dayLeaves?.length)&&(
                <tr><td colSpan={6} style={{textAlign:"center",padding:24,color:"#94a3b8",fontSize:13}}>لا توجد أحداث في هذه الفترة</td></tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}

