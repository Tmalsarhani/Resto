// SHIFTS PAGE — with monthly calendar
// ══════════════════════════════════════
function ShiftsPage({doctors,shifts,leaves,coverages,onAdd,onAssign,onDelete}){
  const [view,setView]=useState("list");
  const [month,setMonth]=useState(()=>{const d=new Date();return{y:d.getFullYear(),m:d.getMonth()};});
  const [form,setForm]=useState({doctorId:"",date:""});
  const [showForm,setShowForm]=useState(false);
  const [leaveWarn,setLeaveWarn]=useState(null);
  const [selShift,setSelShift]=useState(null);
  const doc=(id)=>doctors.find(d=>d.id===id);

  const checkLeave=(docId,date)=>{
    const d=doctors.find(x=>x.id===+docId);
    setLeaveWarn(d&&date&&isOnLeave(d,date,leaves)?`⛔ ${d.name} في إجازة — لا يمكن تكليفه`:null);
  };

  const handleAdd=()=>{
    if(!form.doctorId||!form.date||leaveWarn)return;
    const di=dateToIdx(form.date);
    if(di<0)return alert("جمعة/سبت");
    onAdd({doctorId:+form.doctorId,dayIdx:di,date:form.date});
    setForm({doctorId:"",date:""});setLeaveWarn(null);setShowForm(false);
  };

  // Build monthly calendar
  const calDays=useMemo(()=>{
    const days=[];const daysInMonth=new Date(month.y,month.m+1,0).getDate();
    for(let i=1;i<=daysInMonth;i++){
      const date=`${month.y}-${String(month.m+1).padStart(2,"0")}-${String(i).padStart(2,"0")}`;
      const di=dateToIdx(date);
      const dayShifts=shifts.filter(s=>s.date===date);
      days.push({date,di,day:i,dayShifts});
    }
    return days;
  },[month,shifts]);

  return(
    <div>
      <div style={{display:"flex",gap:8,marginBottom:14,alignItems:"center",flexWrap:"wrap"}}>
        <div style={{fontWeight:700,flex:1}}>المناوبات ({shifts.length})</div>
        <div style={{display:"flex",gap:4}}>
          <button style={{...S.filterBtn,...(view==="list"?S.filterBtnA:{})}} onClick={()=>setView("list")}>قائمة</button>
          <button style={{...S.filterBtn,...(view==="calendar"?S.filterBtnA:{})}} onClick={()=>setView("calendar")}>تقويم شهري</button>
        </div>
        <button style={S.btnP} onClick={()=>setShowForm(true)}>+ مناوبة جديدة</button>
      </div>

      {showForm&&(
        <div style={S.formCard}>
          <div style={{fontWeight:800,fontSize:14,marginBottom:10}}>🌙 مناوبة جديدة</div>
          <label style={S.lbl}>الطبيب</label>
          <select style={S.sel} value={form.doctorId} onChange={e=>{setForm(p=>({...p,doctorId:e.target.value}));checkLeave(e.target.value,form.date);}}>
            <option value="">اختر...</option>
            {doctors.map(d=>{const ol=isOnLeave(d,form.date,leaves);return <option key={d.id} value={d.id}>{ol?`🚫 ${d.name} (إجازة)`:d.name}</option>;})}
          </select>
          <label style={S.lbl}>التاريخ</label>
          <input type="date" style={S.sel} value={form.date} onChange={e=>{setForm(p=>({...p,date:e.target.value}));checkLeave(form.doctorId,e.target.value);}}/>
          {leaveWarn&&<div style={S.errBox}>{leaveWarn}</div>}
          <div style={{display:"flex",gap:8,marginTop:10}}>
            <button style={{...S.btnP,opacity:leaveWarn?0.4:1}} disabled={!!leaveWarn} onClick={handleAdd}>حفظ</button>
            <button style={S.btnS} onClick={()=>{setShowForm(false);setLeaveWarn(null);}}>إلغاء</button>
          </div>
        </div>
      )}

      {view==="calendar"&&(
        <div style={{background:"#fff",border:"1px solid #e2e8f0",borderRadius:12,overflow:"hidden",marginBottom:16}}>
          <div style={{display:"flex",alignItems:"center",gap:10,padding:"12px 16px",borderBottom:"1px solid #e2e8f0"}}>
            <button style={S.filterBtn} onClick={()=>setMonth(p=>p.m===0?{y:p.y-1,m:11}:{y:p.y,m:p.m-1})}>→</button>
            <div style={{flex:1,textAlign:"center",fontWeight:700}}>{MONTH_NAMES[month.m]} {month.y}</div>
            <button style={S.filterBtn} onClick={()=>setMonth(p=>p.m===11?{y:p.y+1,m:0}:{y:p.y,m:p.m+1})}>←</button>
          </div>
          <div style={{overflowX:"auto"}}>
            <table style={{width:"100%",borderCollapse:"collapse",minWidth:700}}>
              <thead>
                <tr>{["الأحد","الاثنين","الثلاثاء","الأربعاء","الخميس"].map(d=><th key={d} style={{padding:"8px",fontSize:11,color:"#64748b",fontWeight:700,background:"#f8fafc",borderBottom:"1px solid #e2e8f0",textAlign:"center"}}>{d}</th>)}</tr>
              </thead>
              <tbody>
                {(()=>{
                  const firstDay=new Date(month.y,month.m,1).getDay();
                  const rows=[];let cells=[];
                  for(let i=0;i<firstDay;i++)cells.push(<td key={`e${i}`} style={{padding:4,borderBottom:"1px solid #f1f5f9"}}/>);
                  calDays.forEach(({date,di,day,dayShifts})=>{
                    if(di<0){if(cells.length){}return;}
                    cells.push(
                      <td key={date} style={{padding:4,borderBottom:"1px solid #f1f5f9",borderRight:"1px solid #f1f5f9",verticalAlign:"top",minWidth:110}}>
                        <div style={{fontSize:11,color:"#94a3b8",marginBottom:4}}>{day}</div>
                        {dayShifts.map(s=>{
                          const d=doctors.find(x=>x.id===s.doctorId);
                          const cam=doctors.find(x=>x.id===s.coverAm);
                          const cpm=doctors.find(x=>x.id===s.coverPm);
                          return d&&(
                            <div key={s.id} style={{background:d.color+"22",border:`1px solid ${d.color}55`,borderRadius:6,padding:"4px 6px",marginBottom:4}}>
                              <div style={{fontWeight:700,fontSize:10,color:d.color}}>🌙 {shortName(d.name)}</div>
                              {cam&&<div style={{fontSize:9,color:"#15803d"}}>☀️ {shortName(cam.name)}</div>}
                              {cpm&&<div style={{fontSize:9,color:"#15803d"}}>🌅 {shortName(cpm.name)}</div>}
                              {!cam&&!cpm&&<div style={{fontSize:9,color:"#dc2626"}}>⚠️ بدون تغطية</div>}
                            </div>
                          );
                        })}
                      </td>
                    );
                    if(cells.length===5){rows.push(<tr key={date}>{cells}</tr>);cells=[];}
                  });
                  if(cells.length)rows.push(<tr key="last">{cells}</tr>);
                  return rows;
                })()}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {view==="list"&&(
        <div style={{display:"flex",gap:16}}>
          <div style={{flex:1}}>
            {shifts.length===0&&<div style={S.empty}>لا توجد مناوبات</div>}
            {shifts.map(s=>{
              const d=doc(s.doctorId);if(!d)return null;
              const needs=needsCoverage(d,s.dayIdx);
              const cam=doc(s.coverAm),cpm=doc(s.coverPm);
              return(
                <div key={s.id} style={{...S.shiftCard,borderColor:selShift?.id===s.id?"#2563eb":"#e2e8f0"}} onClick={()=>setSelShift(selShift?.id===s.id?null:s)}>
                  <div style={{display:"flex",alignItems:"center",gap:8,marginBottom:6}}>
                    <div style={{...S.av,background:d.color,width:30,height:30,fontSize:11}}>{shortName(d.name)}</div>
                    <div style={{flex:1}}><div style={{fontWeight:700,fontSize:13}}>{d.name}</div><div style={{fontSize:11,color:"#64748b"}}>{s.date} — {DAYS[s.dayIdx]}</div></div>
                    <button style={S.btnDel} onClick={e=>{e.stopPropagation();if(confirm("حذف؟"))onDelete(s.id);}}>🗑</button>
                  </div>
                  {!needs.am&&!needs.pm?<div style={S.okBadge}>✅ لا تغطية مطلوبة</div>:(
                    <div style={{display:"flex",gap:6,flexWrap:"wrap"}}>
                      {needs.am&&<div style={{...S.cvBadge,background:cam?"#f0fdf4":"#fef2f2",color:cam?"#15803d":"#dc2626"}}>☀️ {cam?cam.name:"بدون تغطية"}{s.warnAm?" ⚠️":""}</div>}
                      {needs.pm&&<div style={{...S.cvBadge,background:cpm?"#f0fdf4":"#fef2f2",color:cpm?"#15803d":"#dc2626"}}>🌅 {cpm?cpm.name:"بدون تغطية"}{s.warnPm?" ⚠️":""}</div>}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
          {selShift&&<CoverPanel absentDoc={doc(selShift.doctorId)} dayIdx={selShift.dayIdx} date={selShift.date} doctors={doctors} leaves={leaves} shifts={shifts} coverages={coverages} existingAm={selShift.coverAm} existingPm={selShift.coverPm} warnAm={selShift.warnAm} warnPm={selShift.warnPm} onAssign={(period,docId,warn)=>onAssign(selShift.id,period,docId,warn)} onUpdate={(period,docId,warn)=>{onAssign(selShift.id,period,docId,warn);setSelShift(p=>({...p,[period==="am"?"coverAm":"coverPm"]:docId,[period==="am"?"warnAm":"warnPm"]:warn}));}}/>}
        </div>
      )}
    </div>
  );
}

