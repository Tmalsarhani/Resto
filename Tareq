        </div>
        <nav style={{padding:"8px",flex:1}}>
          {TABS.map(t=>(
            <button key={t.id} style={{...S.navBtn,...((page===t.id||page==="schedule"&&t.id==="doctors")?S.navA:{})}} onClick={()=>{setPage(t.id);setSelDoc(null);}}>
              {t.icon} {t.label}
            </button>
          ))}
        </nav>
        <button style={S.saveBtn} onClick={()=>{save();showToast("✅ تم الحفظ");}}>💾 حفظ الكل</button>
      </aside>

      <main style={S.main}>
        <div style={S.topbar}>
          <div style={{fontWeight:800,fontSize:17}}>
            {page==="dashboard"&&"🏥 الداشبورد"}
            {page==="doctors"&&!selDoc&&"👨‍⚕️ الأطباء"}
            {page==="schedule"&&selDoc&&<span><button style={S.backBtn} onClick={()=>{setPage("doctors");setSelDoc(null);}}>← الأطباء</button> / {selDoc.name}</span>}
            {page==="shifts"&&"🌙 المناوبات الليلية"}
            {page==="coverage"&&"🔄 التغطيات والغيابات"}
            {page==="leaves"&&"🏖 الإجازات"}
            {page==="stats"&&"📊 الإحصائيات"}
          </div>
          <div style={{fontSize:12,color:"#64748b"}}>{today}</div>
