                      {dayShifts.map(s=>{const d=doctors.find(x=>x.id===s.doctorId);return d&&<DocChip key={s.id} doc={d}/>;})}{!dayShifts.length&&<span style={{color:"#e2e8f0",fontSize:11}}>—</span>}
                    </td>
