  const addShiftCov=(shiftId,period,docId,warn)=>{
    setShifts(p=>p.map(s=>s.id!==shiftId?s:{...s,[period==="am"?"coverAm":"coverPm"]:docId,[period==="am"?"warnAm":"warnPm"]:warn}));
    const shift=shifts.find(s=>s.id===shiftId);
    addCov({type:"night",date:shift?.date,period,coverDoctorId:docId,absentDoctorId:shift?.doctorId,hadConflict:warn,refId:shiftId});
  };
  const addAbsCov=(absId,period,docId,warn,date,absentDocId)=>{
    addCov({type:"absence",date,period,coverDoctorId:docId,absentDoctorId:absentDocId,hadConflict:warn,refId:absId});
