                      {dayShifts.map(s=>{const d=doctors.find(x=>x.id===s.coverAm);return d&&<DocChip key={s.id} doc={d} warn={s.warnAm}/>;})}{dayCovs.filter(c=>c.period==="am").map(c=>{const d=doctors.find(x=>x.id===c.coverDoctorId);return d&&<DocChip key={c.id} doc={d} warn={c.hadConflict}/>;})}{!dayShifts.some(s=>s.coverAm)&&!dayCovs.some(c=>c.period==="am")&&<span style={{color:"#e2e8f0",fontSize:11}}>—</span>}
                    </td>
