  const TABS=[
    {id:"dashboard",icon:"🏥",label:"الداشبورد"},
    {id:"doctors",icon:"👨‍⚕️",label:"الأطباء"},
    {id:"shifts",icon:"🌙",label:"المناوبات"},
    {id:"coverage",icon:"🔄",label:"التغطيات"},
    {id:"leaves",icon:"🏖",label:"الإجازات"},
