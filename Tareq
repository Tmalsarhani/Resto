const G={get:(k)=>{try{return JSON.parse(localStorage.getItem(k));}catch{return null;}},set:(k,v)=>localStorage.setItem(k,JSON.stringify(v))};
const isClinic=(t)=>t==="clinic_am"||t==="clinic_pm";
const getSlot=(doc,di,p)=>doc.sched[di]?.[p]||"";
const weeklySlots=(doc)=>Object.values(doc.sched).reduce((a,d)=>a+(isClinic(d.am)?1:0)+(isClinic(d.pm)?1:0),0);
const isOnLeave=(doc,date,leaves)=>!date||!doc?false:leaves.some(l=>l.doctorId===doc.id&&l.start<=date&&date<=l.end);
const needsCoverage=(doc,di)=>({am:isClinic(getSlot(doc,di,"am")),pm:isClinic(getSlot(doc,di,"pm"))});
const shortName=(name)=>name.replace("د.","").replace("د ","").trim().slice(0,5);
const dateToIdx=(dateStr)=>{const d=new Date(dateStr);const py=d.getDay();return py<5?py:-1;};

function getAvail(doctors,absentId,di,date,period,leaves,shifts,coverages){
  return doctors.filter(d=>d.id!==absentId).map(d=>{
    if(isOnLeave(d,date,leaves))return{doctor:d,status:"leave"};
    if(shifts.some(s=>s.doctorId===d.id&&s.dayIdx===di&&s.date===date))return{doctor:d,status:"night"};
    if(coverages.some(c=>c.coverDoctorId===d.id&&c.date===date&&c.period===period))return{doctor:d,status:"busy"};
    const slot=getSlot(d,di,period);
    if(slot==="")return{doctor:d,status:"available"};
    if(["admin","training","committee"].includes(slot))return{doctor:d,status:"warn",conflict:slot};
    return{doctor:d,status:"busy"};
  }).filter(d=>d.status!=="busy").sort((a,b)=>({available:0,warn:1,night:2,leave:3}[a.status]-{available:0,warn:1,night:2,leave:3}[b.status]));
}

