// STATS PAGE
// ══════════════════════════════════════
function StatsPage({doctors,shifts,coverages,absences,leaves}){
  const doc=(id)=>doctors.find(d=>d.id===id);
  const total={shifts:shifts.length,coverages:coverages.length,absences:absences.length,leaves:leaves.reduce((a,l)=>a+Math.round((new Date(l.end)-new Date(l.start))/86400000)+1,0)};

  const chartData=doctors.map(d=>({
    name:shortName(d.name),
    مناوبات:shifts.filter(s=>s.doctorId===d.id).length,
    تغطيات:coverages.filter(c=>c.coverDoctorId===d.id).length,
    غيابات:absences.filter(a=>a.doctorId===d.id).length,
    color:d.color,
  })).filter(d=>d.مناوبات||d.تغطيات||d.غيابات);

  const pieData=[
    {name:"مناوبات",value:total.shifts,color:"#2563eb"},
    {name:"تغطيات",value:total.coverages,color:"#15803d"},
    {name:"غيابات",value:total.absences,color:"#dc2626"},
    {name:"أيام إجازة",value:total.leaves,color:"#d97706"},
  ].filter(d=>d.value>0);

  return(
    <div>
      <div style={{display:"grid",gridTemplateColumns:"repeat(4,1fr)",gap:10,marginBottom:20}}>
        {[
          {icon:"🌙",label:"مناوبات",val:total.shifts,color:"#1d4ed8",bg:"#eff6ff"},
          {icon:"🔄",label:"تغطيات",val:total.coverages,color:"#15803d",bg:"#f0fdf4"},
          {icon:"❌",label:"غيابات",val:total.absences,color:"#dc2626",bg:"#fef2f2"},
          {icon:"🏖",label:"أيام إجازة",val:total.leaves,color:"#d97706",bg:"#fffbeb"},
        ].map(({icon,label,val,color,bg})=>(
          <div key={label} style={{background:"#fff",border:"1px solid #e2e8f0",borderRadius:12,padding:16,textAlign:"center"}}>
            <div style={{fontSize:24}}>{icon}</div>
            <div style={{fontSize:30,fontWeight:800,color}}>{val}</div>
            <div style={{fontSize:11,color:"#64748b"}}>{label}</div>
          </div>
        ))}
      </div>

      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:16,marginBottom:20}}>
        <div style={{background:"#fff",border:"1px solid #e2e8f0",borderRadius:12,padding:16}}>
          <div style={{fontWeight:700,marginBottom:12,fontSize:14}}>مقارنة الأطباء</div>
          {chartData.length===0?<div style={S.empty}>لا توجد بيانات</div>:(
            <ResponsiveContainer width="100%" height={200}>
              <BarChart data={chartData} margin={{top:0,right:0,left:-25,bottom:0}}>
                <XAxis dataKey="name" tick={{fontSize:9,fill:"#64748b"}}/>
                <YAxis tick={{fontSize:9,fill:"#64748b"}} allowDecimals={false}/>
                <Tooltip contentStyle={{background:"#fff",border:"1px solid #e2e8f0",borderRadius:8,fontSize:11}}/>
                <Bar dataKey="مناوبات" fill="#2563eb" radius={[3,3,0,0]}/>
                <Bar dataKey="تغطيات" fill="#15803d" radius={[3,3,0,0]}/>
                <Bar dataKey="غيابات" fill="#dc2626" radius={[3,3,0,0]}/>
              </BarChart>
            </ResponsiveContainer>
          )}
        </div>
        <div style={{background:"#fff",border:"1px solid #e2e8f0",borderRadius:12,padding:16}}>
          <div style={{fontWeight:700,marginBottom:12,fontSize:14}}>التوزيع الإجمالي</div>
          {pieData.length===0?<div style={S.empty}>لا توجد بيانات</div>:(
            <ResponsiveContainer width="100%" height={200}>
              <PieChart>
                <Pie data={pieData} cx="50%" cy="50%" outerRadius={70} dataKey="value" label={({name,value})=>`${name}: ${value}`} labelLine={false} fontSize={10}>
                  {pieData.map((entry,i)=><Cell key={i} fill={entry.color}/>)}
                </Pie>
                <Tooltip/>
              </PieChart>
            </ResponsiveContainer>
          )}
        </div>
      </div>

      <div style={{display:"grid",gridTemplateColumns:"repeat(auto-fill,minmax(185px,1fr))",gap:10}}>
        {doctors.map(d=>{
          const myShifts=shifts.filter(s=>s.doctorId===d.id).length;
          const myExtra=coverages.filter(c=>c.coverDoctorId===d.id).length;
          const myAbsent=absences.filter(a=>a.doctorId===d.id).length;
          const myLeaves=leaves.filter(l=>l.doctorId===d.id).reduce((a,l)=>a+Math.round((new Date(l.end)-new Date(l.start))/86400000)+1,0);
          const slots=weeklySlots(d);
          const pressure=Math.min(100,Math.round(((myShifts+myExtra)/Math.max(slots*4,1))*100));
          return(
            <div key={d.id} style={{background:"#fff",border:"1px solid #e2e8f0",borderRadius:10,padding:12,borderRight:`4px solid ${d.color}`}}>
              <div style={{display:"flex",alignItems:"center",gap:6,marginBottom:10}}>
                <div style={{...S.av,background:d.color,width:28,height:28,fontSize:10}}>{shortName(d.name)}</div>
                <div style={{fontWeight:700,fontSize:12}}>{d.name}</div>
              </div>
              {[{icon:"🌙",v:myShifts,c:"#1d4ed8",bg:"#eff6ff",l:"مناوبات"},
                {icon:"🔄",v:myExtra,c:"#15803d",bg:"#f0fdf4",l:"تغطيات"},
                {icon:"❌",v:myAbsent,c:"#dc2626",bg:"#fef2f2",l:"غيابات"},
                {icon:"🏖",v:myLeaves,c:"#d97706",bg:"#fffbeb",l:"إجازة"},
              ].map(({icon,v,c,bg,l})=>(
                <div key={l} style={{display:"flex",justifyContent:"space-between",background:bg,borderRadius:5,padding:"3px 7px",marginBottom:3}}>
                  <span style={{fontSize:11,color:c}}>{icon} {l}</span>
                  <strong style={{color:c,fontSize:12}}>{v}</strong>
                </div>
              ))}
              <div style={{marginTop:8}}>
                <div style={{display:"flex",justifyContent:"space-between",fontSize:10,color:"#64748b",marginBottom:2}}>
                  <span>ضغط العمل</span>
                  <span style={{fontWeight:700,color:pressure>60?"#dc2626":pressure>30?"#d97706":"#15803d"}}>{pressure}%</span>
                </div>
                <div style={{height:4,background:"#e2e8f0",borderRadius:2,overflow:"hidden"}}>
                  <div style={{height:"100%",width:`${pressure}%`,background:pressure>60?"#dc2626":pressure>30?"#d97706":d.color,borderRadius:2}}/>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
}

