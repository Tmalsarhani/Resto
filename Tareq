            <input type="date" style={S.sel} value={form.date} onChange={e=>{setForm(p=>({...p,date:e.target.value}));checkLeave(form.doctorId,e.target.value);}}/>
            <label style={S.lbl}>السبب</label>
            <select style={S.sel} value={form.reason} onChange={e=>setForm(p=>({...p,reason:e.target.value}))}>
              {Object.entries(reasons).map(([k,v])=><option key={k} value={k}>{v}</option>)}
            </select>
            {leaveWarn&&<div style={S.errBox}>{leaveWarn}</div>}
            <div style={{display:"flex",gap:8,marginTop:10}}>
              <button style={{...S.btnP,opacity:leaveWarn?0.4:1}} disabled={!!leaveWarn} onClick={handleAdd}>حفظ</button>
              <button style={S.btnS} onClick={()=>setShowForm(false)}>إلغاء</button>
            </div>
          </div>
        )}
        {filtered.length===0&&<div style={S.empty}>لا توجد سجلات</div>}
        {filtered.map(abs=>{
          const d=doc(abs.doctorId);if(!d)return null;
          const needs=needsCoverage(d,abs.dayIdx);
          return(
            <div key={abs.id} style={{...S.shiftCard,borderColor:selAbs?.id===abs.id?"#2563eb":"#e2e8f0"}} onClick={()=>setSelAbs(selAbs?.id===abs.id?null:{...abs})}>
              <div style={{display:"flex",alignItems:"center",gap:8,marginBottom:6}}>
                <div style={{...S.av,background:d.color,width:30,height:30,fontSize:11}}>{shortName(d.name)}</div>
                <div style={{flex:1}}><div style={{fontWeight:700,fontSize:13}}>{d.name}</div><div style={{fontSize:11,color:"#64748b"}}>{abs.date} — {DAYS[abs.dayIdx]} — {reasons[abs.reason]}</div></div>
                <button style={S.btnDel} onClick={e=>{e.stopPropagation();if(confirm("حذف؟"))onDeleteAbsence(abs.id);}}>🗑</button>
              </div>
              {!needs.am&&!needs.pm?<div style={S.okBadge}>✅ لا تغطية مطلوبة</div>:(
                <div style={{display:"flex",gap:6,flexWrap:"wrap"}}>
                  {needs.am&&(()=>{const cov=abs.covs.find(c=>c.period==="am");const cd=cov?doc(cov.coverDoctorId):null;return <div style={{...S.cvBadge,background:cd?"#f0fdf4":"#fef2f2",color:cd?"#15803d":"#dc2626"}}>☀️ {cd?cd.name:"بدون تغطية"}{cov?.hadConflict?" ⚠️":""}</div>;})()}
                  {needs.pm&&(()=>{const cov=abs.covs.find(c=>c.period==="pm");const cd=cov?doc(cov.coverDoctorId):null;return <div style={{...S.cvBadge,background:cd?"#f0fdf4":"#fef2f2",color:cd?"#15803d":"#dc2626"}}>🌅 {cd?cd.name:"بدون تغطية"}{cov?.hadConflict?" ⚠️":""}</div>;})()}
                </div>
              )}
            </div>
          );
        })}
      </div>
      {selAbs&&<CoverPanel absentDoc={doc(selAbs.doctorId)} dayIdx={selAbs.dayIdx} date={selAbs.date} doctors={doctors} leaves={leaves} shifts={shifts} coverages={coverages} existingAm={selAbs.covs?.find(c=>c.period==="am")?.coverDoctorId} existingPm={selAbs.covs?.find(c=>c.period==="pm")?.coverDoctorId} warnAm={selAbs.covs?.find(c=>c.period==="am")?.hadConflict} warnPm={selAbs.covs?.find(c=>c.period==="pm")?.hadConflict}
        onUpdate={(period,docId,warn)=>{onAssign(selAbs.id,period,docId,warn,selAbs.date,selAbs.doctorId);setSelAbs(prev=>({...prev,covs:[...prev.covs.filter(c=>c.period!==period),{period,coverDoctorId:docId,hadConflict:warn}]}));}}/>}
    </div>
  );
}

// ══════════════════════════════════════
// COVER PANEL (shared)
// ══════════════════════════════════════
function CoverPanel({absentDoc,dayIdx,date,doctors,leaves,shifts,coverages,existingAm,existingPm,warnAm,warnPm,onUpdate}){
  if(!absentDoc)return null;
  const doc=(id)=>doctors.find(d=>d.id===id);
  const needs=needsCoverage(absentDoc,dayIdx);
  return(
    <div style={{width:260,flexShrink:0,background:"#fff",border:"1px solid #e2e8f0",borderRadius:12,padding:14,height:"fit-content"}}>
      <div style={{fontWeight:800,fontSize:14,marginBottom:4}}>تعيين التغطية</div>
      <div style={{fontSize:12,color:"#64748b",marginBottom:12}}>{absentDoc.name} — {date} ({DAYS[dayIdx]})</div>
      {!needs.am&&!needs.pm&&<div style={S.okBadge}>✅ جدول فارغ — لا تغطية</div>}
      {["am","pm"].filter(p=>needs[p]).map(period=>{
        const avail=getAvail(doctors,absentDoc.id,dayIdx,date,period,leaves,shifts,coverages);
        const cur=period==="am"?existingAm:existingPm;
        const warn=period==="am"?warnAm:warnPm;
        const curDoc=doc(cur);
        return(
          <div key={period} style={{marginBottom:14}}>
            <div style={{fontWeight:700,fontSize:12,color:"#475569",marginBottom:6}}>{period==="am"?"☀️ صباح":"🌅 ظهر"}</div>
            {curDoc&&<div style={{background:"#f0fdf4",color:"#15803d",border:"1px solid #bbf7d0",borderRadius:6,padding:"4px 8px",fontSize:11,fontWeight:600,marginBottom:6}}>✅ {curDoc.name}{warn?" ⚠️":""}</div>}
            <div style={{display:"flex",flexDirection:"column",gap:4}}>
              {avail.length===0&&<div style={{fontSize:11,color:"#94a3b8",textAlign:"center",padding:"8px 0"}}>لا يوجد متاح</div>}
              {avail.map(({doctor:d,status,conflict})=>{
                const ST={available:{bg:"#f0fdf4",color:"#15803d",border:"#bbf7d0",lbl:"✅"},warn:{bg:"#fffbeb",color:"#d97706",border:"#fde68a",lbl:"⚠️"},night:{bg:"#eff6ff",color:"#1d4ed8",border:"#bfdbfe",lbl:"🌙"},leave:{bg:"#fef2f2",color:"#dc2626",border:"#fecaca",lbl:"🚫"}};
                const s=ST[status];const disabled=status==="leave";
                return(
                  <button key={d.id} disabled={disabled} style={{display:"flex",alignItems:"center",gap:6,padding:"5px 8px",borderRadius:7,border:`1px solid ${s.border}`,background:s.bg,color:s.color,fontSize:11,fontWeight:600,cursor:disabled?"not-allowed":"pointer",opacity:disabled?0.5:1,width:"100%"}}
                    onClick={()=>{
                      if(disabled)return;
                      const warn=status==="warn";
                      if(warn&&!confirm(`${d.name} لديه ${SLOT_TYPES[conflict]?.label} — تكليفه؟`))return;
                      onUpdate(period,d.id,warn);
                    }}>
                    <div style={{...S.av,background:d.color,width:18,height:18,fontSize:8,flexShrink:0}}>{shortName(d.name)}</div>
                    <span style={{flex:1,textAlign:"right"}}>{d.name}</span>
                    <span style={{fontSize:10}}>{s.lbl}</span>
                  </button>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  );
}

