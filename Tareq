function DashboardPage({doctors,shifts,coverages,absences,leaves,today}){
  const [view,setView]=useState("day"); // day | week | month
  const [refDate,setRefDate]=useState(today);
  const doc=(id)=>doctors.find(d=>d.id===id);

  const getDateRange=()=>{
    const d=new Date(refDate);
    if(view==="day") return [refDate];
    if(view==="week"){
      const dates=[];const start=new Date(d);
      const day=start.getDay();start.setDate(start.getDate()-day);
      for(let i=0;i<5;i++){const dt=new Date(start);dt.setDate(start.getDate()+i);const di=dt.getDay();if(di<5)dates.push(dt.toISOString().split("T")[0]);}
      return dates;
    }
    if(view==="month"){
      const dates=[];const y=d.getFullYear(),m=d.getMonth();
      const daysInMonth=new Date(y,m+1,0).getDate();
      for(let i=1;i<=daysInMonth;i++){const dt=new Date(y,m,i);if(dt.getDay()<5)dates.push(dt.toISOString().split("T")[0]);}
      return dates;
    }
    return [refDate];
  };

  const dates=getDateRange();

  // Events per date
  const eventsByDate=dates.map(date=>{
    const di=dateToIdx(date);
    if(di<0)return{date,events:[]};
    const dayShifts=shifts.filter(s=>s.date===date);
    const dayAbsences=absences.filter(a=>a.date===date);
    const dayLeaves=leaves.filter(l=>l.start<=date&&date<=l.end);
    const dayCovs=coverages.filter(c=>c.date===date);
    return{date,di,dayShifts,dayAbsences,dayLeaves,dayCovs};
  }).filter(d=>d.events!==null);

  const todayOnLeave=leaves.filter(l=>l.start<=today&&today<=l.end);
  const todayShifts=shifts.filter(s=>s.date===today);
  const todayCovs=coverages.filter(c=>c.date===today);
  const todayAbsences=absences.filter(a=>a.date===today);

  return(
    <div>
      {/* Summary strip */}
      <div style={{display:"grid",gridTemplateColumns:"repeat(4,1fr)",gap:10,marginBottom:20}}>
        {[
          {icon:"🏖",label:"إجازة اليوم",val:todayOnLeave.length,color:"#dc2626",bg:"#fef2f2"},
          {icon:"🌙",label:"مناوبة اليوم",val:todayShifts.length,color:"#1d4ed8",bg:"#eff6ff"},
          {icon:"❌",label:"غياب اليوم",val:todayAbsences.length,color:"#d97706",bg:"#fffbeb"},
          {icon:"🔄",label:"تغطية اليوم",val:todayCovs.length,color:"#15803d",bg:"#f0fdf4"},
        ].map(({icon,label,val,color,bg})=>(
          <div key={label} style={{background:"#fff",border:"1px solid #e2e8f0",borderRadius:12,padding:"14px",textAlign:"center"}}>
            <div style={{fontSize:26}}>{icon}</div>
            <div style={{fontSize:28,fontWeight:800,color}}>{val}</div>
            <div style={{fontSize:11,color:"#64748b"}}>{label}</div>
          </div>
        ))}
      </div>

      {/* Today's detail */}
      {(todayOnLeave.length>0||todayShifts.length>0||todayAbsences.length>0)&&(
        <div style={{display:"flex",gap:10,marginBottom:20,flexWrap:"wrap"}}>
          {todayOnLeave.length>0&&(
            <div style={{background:"#fef2f2",border:"1px solid #fecaca",borderRadius:10,padding:"10px 14px",flex:1,minWidth:180}}>
              <div style={{fontWeight:700,color:"#dc2626",marginBottom:6}}>🏖 في إجازة اليوم</div>
              {todayOnLeave.map(l=>{const d=doctors.find(x=>x.id===l.doctorId);return d&&<div key={l.id} style={{display:"flex",alignItems:"center",gap:6,marginBottom:4}}><div style={{...S.av,background:d.color,width:22,height:22,fontSize:9}}>{shortName(d.name)}</div><span style={{fontSize:12}}>{d.name}</span></div>;})}
            </div>
          )}
          {todayShifts.length>0&&(
            <div style={{background:"#eff6ff",border:"1px solid #bfdbfe",borderRadius:10,padding:"10px 14px",flex:1,minWidth:180}}>
              <div style={{fontWeight:700,color:"#1d4ed8",marginBottom:6}}>🌙 مناوبة الليلة</div>
              {todayShifts.map(s=>{const d=doctors.find(x=>x.id===s.doctorId);const cam=doctors.find(x=>x.id===s.coverAm);const cpm=doctors.find(x=>x.id===s.coverPm);return d&&(
                <div key={s.id} style={{marginBottom:6}}>
                  <div style={{display:"flex",alignItems:"center",gap:6,marginBottom:2}}><div style={{...S.av,background:d.color,width:22,height:22,fontSize:9}}>{shortName(d.name)}</div><span style={{fontSize:12,fontWeight:700}}>{d.name}</span></div>
