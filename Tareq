              </tr>
            </thead>
            <tbody>
              {eventsByDate.map(({date,di,dayShifts,dayAbsences,dayLeaves,dayCovs})=>{
                if(!dayShifts?.length&&!dayAbsences?.length&&!dayLeaves?.length)return null;
